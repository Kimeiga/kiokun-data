{
  "name": "kiokun-notes-sveltekit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -n cors,vite -c blue,green \"npm run dev:cors\" \"sleep 1 && vite dev\"",
    "dev:cors": "cd ../output_dictionary && python3 cors_server.py",
    "dev:vite": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name=kiokun --commit-dirty=true",
    "cf-typegen": "wrangler types",
    "test": "npx tsx src/lib/utils/korean-deinflect.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.5.28",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "svelte": "^5.1.9",
    "svelte-check": "^4.0.4",
    "tailwindcss": "^3.4.18",
    "tslib": "^2.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@mcp-b/global": "^1.6.0",
    "@types/dompurify": "^3.0.5",
    "better-auth": "^1.3.29",
    "better-sqlite3": "^12.6.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.3.0",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "fflate": "^0.8.2",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data-jp": "^0.0.2",
    "isomorphic-dompurify": "^2.30.1",
    "jieba-wasm": "^2.4.0",
    "kuromoji": "^0.1.2",
    "marked": "^16.4.1",
    "opencc-js": "^1.3.1",
    "pako": "^2.1.0",
    "svelte-dnd-action": "^0.9.69",
    "tiny-segmenter": "^0.2.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "type": "module"
}
