{
  "name": "kiokun-notes-sveltekit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently -n cors,vite -c blue,green \"npm run dev:cors\" \"sleep 1 && vite dev --host\"",
    "dev:cors": "cd ../output_dictionary && python3 cors_server.py",
    "dev:vite": "vite dev",
    "build": "vite build",
    "build:capacitor": "node scripts/build-capacitor.js",
    "cap:sync": "npm run build:capacitor && cap sync ios",
    "cap:open": "cap open ios",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "npm run build && node scripts/prune-cloudflare-output.js && wrangler pages deploy .svelte-kit/cloudflare --project-name=kiokun --commit-dirty=true",
    "cf-typegen": "wrangler types",
    "test": "node extract_homophones.test.mjs && npx tsx src/lib/utils/korean-deinflect.test.ts && npx tsx src/lib/utils/chinese-ruby.test.ts && npx tsx src/lib/contains-order.test.ts && npx tsx src/lib/character-forms.test.ts && npx tsx src/lib/seo.test.ts && npx tsx src/lib/character-corpus-invariants.test.ts",
    "test:character-forms": "npx tsx src/lib/character-forms.test.ts",
    "test:character-corpus": "npx tsx src/lib/character-corpus-invariants.test.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.5.28",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^25.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "picomatch": "4.0.4",
    "postcss": "^8.5.6",
    "sass-embedded": "^1.100.0",
    "sharp": "^0.34.5",
    "svelte": "^5.1.9",
    "svelte-check": "^4.0.4",
    "tailwindcss": "^3.4.18",
    "tslib": "^2.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.45.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@cf-wasm/resvg": "^0.3.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@mcp-b/global": "^1.6.0",
    "@snap-engine/asset-base": "0.4.0",
    "@snap-engine/asset-base-svelte": "0.4.0",
    "@snap-engine/core": "0.4.0",
    "@snap-engine/snapsort": "0.4.0",
    "@snap-engine/snapsort-svelte": "0.4.0",
    "@types/dompurify": "^3.0.5",
    "better-auth": "^1.3.29",
    "better-sqlite3": "^12.6.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.3.0",
    "drizzle-kit": "^0.31.5",
    "drizzle-orm": "^0.44.6",
    "fflate": "^0.8.2",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data-jp": "^0.0.2",
    "isomorphic-dompurify": "^2.30.1",
    "jieba-wasm": "^2.4.0",
    "kuromoji": "^0.1.2",
    "marked": "^16.4.1",
    "opencc-js": "^1.3.1",
    "pako": "^2.1.0",
    "tiny-segmenter": "^0.2.0",
    "zod-to-json-schema": "^3.25.1"
  },
  "type": "module"
}
