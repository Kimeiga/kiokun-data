{"words":{"了":[{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":7.5600000000000005,"end_time":8.44,"sentence":"那我丢了吧"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":9.64,"end_time":11.24,"sentence":"因为我这保持了好久啊"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":16.36,"end_time":17.76,"sentence":"好好好 那我修了啊"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":29.24,"end_time":30.24,"sentence":"那你先修了师傅"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":41.879999999999995,"end_time":42.76,"sentence":"上颜色了是吧"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":44.16,"end_time":45.4,"sentence":"这个红加太多了"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":45.4,"end_time":46.239999999999995,"sentence":"不快了"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":46.8,"end_time":49.4,"sentence":"这个快啊颜色都快上好了不"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":49.4,"end_time":50.480000000000004,"sentence":"差不多了吧"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":76.96000000000001,"end_time":78.60000000000001,"sentence":"你惠州开了很多宠物店啊"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":82.44,"end_time":85.28,"sentence":"你是我见过颜色最高的宠物店老板娘了"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":96.44000000000001,"end_time":98.52000000000001,"sentence":"等一下我再喷个钮就可以了"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":108.92,"end_time":110.56,"sentence":"那就光泽度就出来了"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":111.16,"end_time":111.68,"sentence":"好了啊"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":111.68,"end_time":112.48,"sentence":"这个修好了"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":157.16,"end_time":158.07999999999998,"sentence":"再拔掉就可以了"},{"video_id":"a59b78d6-5e44-4a28-9d51-f9b2f048fc79","start_time":35.3,"end_time":36.5,"sentence":"你是不是喝醉了?"},{"video_id":"b226a49c-2f48-46d3-a15a-bbe7b37953b9","start_time":10,"end_time":11.4,"sentence":"怎麼又分手了"},{"video_id":"b226a49c-2f48-46d3-a15a-bbe7b37953b9","start_time":30,"end_time":32,"sentence":"對了 剛衣光說你的臭雞腿"},{"video_id":"bbfd2e1b-123e-4142-84db-5ed08c81af75","start_time":4.96,"end_time":7.2,"sentence":"她剛剛完成了有史以來最瘋狂的兒作劇之一"},{"video_id":"bbfd2e1b-123e-4142-84db-5ed08c81af75","start_time":13.88,"end_time":16.2,"sentence":"怎麼說呢 萊莉發布了六七兒作劇"},{"video_id":"bbfd2e1b-123e-4142-84db-5ed08c81af75","start_time":17.080000000000002,"end_time":19.48,"sentence":"回了她的未來 她永遠無法上大學"},{"video_id":"bbfd2e1b-123e-4142-84db-5ed08c81af75","start_time":19.48,"end_time":23.080000000000002,"sentence":"你認為萊莉這次六七兒作劇做得太過分了嗎"},{"video_id":"c094f9e4-6c99-4f1e-ab57-cea54e1823b1","start_time":40,"end_time":41,"sentence":"我被杆了"},{"video_id":"c094f9e4-6c99-4f1e-ab57-cea54e1823b1","start_time":41,"end_time":43,"sentence":"对,你打这个过程,你打它就飞去了"},{"video_id":"c094f9e4-6c99-4f1e-ab57-cea54e1823b1","start_time":51,"end_time":55,"sentence":"我查了一下,我觉得这个游戏啊,是来自中亚的"},{"video_id":"c094f9e4-6c99-4f1e-ab57-cea54e1823b1","start_time":57,"end_time":59,"sentence":"游戏玩完了,去吃饭"},{"video_id":"d1017e00-dd51-41c7-89d3-f696baac89f7","start_time":11.26,"end_time":12.6,"sentence":"装下的都花了"},{"video_id":"d1017e00-dd51-41c7-89d3-f696baac89f7","start_time":23.92,"end_time":25.560000000000002,"sentence":"掀起了话题"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":8.94,"end_time":11.22,"sentence":"因为呢经过了一年的洗礼"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":26.740000000000002,"end_time":29.36,"sentence":"现在已经将新的纱窗给铺了上去"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":55.14,"end_time":58.2,"sentence":"现在独立作业也可以说是驾轻就熟了"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":61.24,"end_time":65.16,"sentence":"今年的换纱窗仪式就圆满落幕了"}],"來":[{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":127.48,"end_time":127.92,"sentence":"来"},{"video_id":"5ab9e704-5501-4051-919b-488616649717","start_time":146.44,"end_time":147.76,"sentence":"下次我再来帮你修啊"},{"video_id":"b13dc0c2-5d30-415d-a783-28a90fb03989","start_time":2,"end_time":4,"sentence":"然後你就知道為什麼大家來一個"},{"video_id":"d1017e00-dd51-41c7-89d3-f696baac89f7","start_time":18.96,"end_time":20.8,"sentence":"男孩最怕我来的亲戚"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":13.48,"end_time":16.240000000000002,"sentence":"是没有办法用水呢来清除的"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":16.240000000000002,"end_time":19.6,"sentence":"所以呢就要来透过换纱窗这样的一个仪式"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":19.6,"end_time":24.64,"sentence":"来代表说呢新的一年要继续的保持整洁以及清爽"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":29.36,"end_time":31.06,"sentence":"那么现在要来进行的呢"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":31.06,"end_time":35.44,"sentence":"就是用胶条以及滚轮来将这个纱窗给固定好"},{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":43.4,"end_time":48.18,"sentence":"来保持整个纱窗的表面呢要是非常平整的"}],"表演":[{"video_id":"f1d9d7ec-321b-4e64-a4f5-608880733e2c","start_time":0.84,"end_time":4.8,"sentence":"欢迎收看一年一度凌家换纱窗才艺表演大赛"}]}}
