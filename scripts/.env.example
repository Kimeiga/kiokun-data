# Learning Resources Automation - Environment Variables
# Copy this file to .env and fill in your actual values

# YouTube Data API v3
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini Pro API
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Account ID
# Find in: Cloudflare Dashboard → Workers & Pages → Overview (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare D1 Database ID
# Default for kiokun-dictionary (from wrangler.toml)
CLOUDFLARE_D1_DATABASE_ID=21f5b45e-ce53-4a63-b07b-dec1a0b44fcc

# Cloudflare API Token
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account → D1 → Edit
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

